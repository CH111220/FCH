<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.msgguard.app"
    android:versionCode="1"
    android:versionName="1.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>

  <!-- 媒体捕获：新版 QQ 把聊天图片/视频存到公共共享媒体区，MediaStore 可查 -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
      android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
  <!-- 全文件通道：30+ 需用户在设置授予"所有文件访问" -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" android:minSdkVersion="30"/>

  <!-- 包可见性：Android 11+ 不声明就查不到 Shizuku 各版本包，检测会误报"未安装" -->
  <queries>
    <package android:name="moe.shizuku.privileged.api"/>
    <package android:name="com.rikka.shizuku"/>
    <package android:name="com.ridwa.shizuku"/>
    <package android:name="com.solemn.shizuku"/>
    <package android:name="com.tencent.mobileqq"/>
  </queries>

  <!-- Shizuku V3 客户端条件之二：缺了它 Shizuku 的扫描不认本应用（授权列表不出现） -->
  <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:allowBackup="false"
      android:hardwareAccelerated="true"
      android:largeHeap="true">

    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <activity android:name=".ConvActivity" android:exported="false"/>
    <activity android:name=".MediaActivity" android:exported="false" android:screenOrientation="unspecified"/>
    <activity android:name=".SettingsActivity" android:exported="false"/>

    <!-- 通知监听：实时捕获 QQ 消息与撤回事件 -->
    <service
        android:name=".MsgGuardListener"
        android:label="消息防撤回 · 实时归档"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService"/>
      </intent-filter>
    </service>

    <!-- 客户端 Shizuku provider：Shizuku 授权后把 IShizukuService binder 推送给我们 -->
    <provider
        android:name=".SzProvider"
        android:authorities="com.msgguard.app.shizuku"
        android:multiprocess="false"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>

    <!-- Shizuku V3（13.6+）客户端声明：缺了它 Shizuku 的应用/授权列表里不会出现本应用 -->
    <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true"/>
  </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- 组卡内的单条消息（发送人抬头已在组卡里，这里只留时间 + 气泡） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="24dp"
    android:paddingTop="4dp" android:paddingBottom="4dp">

  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
    <TextView
        android:id="@+id/msgSender"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="发送人"
        android:textSize="12sp" android:textColor="@color/sub"/>
    <TextView
        android:id="@+id/msgTime"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="--"
        android:textSize="11sp" android:textColor="@color/faint"/>
  </LinearLayout>

  <TextView
      android:id="@+id/msgContent"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="内容"
      android:textSize="15sp" android:lineSpacingExtra="4dp"
      android:paddingStart="13dp" android:paddingEnd="13dp"
      android:paddingTop="10dp" android:paddingBottom="10dp"
      android:textColor="@color/ink"
      android:background="@drawable/bubble_white"/>

  <TextView
      android:id="@+id/msgRecalled"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:visibility="gone"
      android:text="已撤回 · 21:03"
      android:textSize="11sp" android:textColor="@color/danger"
      android:background="@drawable/tag_recall"
      android:paddingStart="8dp" android:paddingEnd="8dp"
      android:paddingTop="3dp" android:paddingBottom="3dp"/>
</LinearLayout>

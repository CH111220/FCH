<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/glass_card">

  <ImageView
      android:id="@+id/thumb"
      android:layout_width="64dp" android:layout_height="64dp"
      android:scaleType="centerCrop" android:background="#F2F4F7"
      android:contentDescription=""/>
  <LinearLayout
      android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:layout_marginStart="12dp"
      android:orientation="vertical">
    <TextView
        android:id="@+id/mName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="文件名"
        android:textSize="13sp" android:textStyle="bold"
        android:singleLine="true" android:ellipsize="middle"
        android:textColor="@color/ink"/>
    <TextView
        android:id="@+id/mTime"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="刚刚 · 123 KB"
        android:textSize="11sp" android:textColor="@color/faint"/>
  </LinearLayout>
  <TextView
      android:id="@+id/mKind"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="图片"
      android:textSize="11sp" android:textColor="@color/accent"
      android:background="@drawable/search_box"
      android:paddingStart="8dp" android:paddingEnd="8dp"
      android:paddingTop="4dp" android:paddingBottom="4dp"/>
</LinearLayout>

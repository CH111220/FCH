<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

  <ScrollView
      android:layout_width="match_parent" android:layout_height="match_parent"
      android:fillViewport="true" android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp"
        android:clipToPadding="false">

      <!-- 顶部：品牌 + 操作 -->
      <LinearLayout
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="@string/app_name"
              android:textSize="23sp" android:textStyle="bold" android:letterSpacing="0.02"
              android:textColor="@color/ink"/>
          <TextView
              android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="@string/tagline"
              android:textSize="12sp" android:textColor="@color/sub"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="44dp" android:layout_height="44dp"
            android:padding="11dp" android:src="@drawable/ic_search"
            android:background="@drawable/glass_btn" android:scaleType="center"
            android:contentDescription="search"/>
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:padding="11dp" android:src="@drawable/ic_gear"
            android:background="@drawable/glass_btn" android:scaleType="center"
            android:contentDescription="settings"/>
      </LinearLayout>

      <!-- 归档状态卡 -->
      <LinearLayout
          android:id="@+id/statusCard"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:orientation="vertical" android:padding="18dp"
          android:background="@drawable/glass_card">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
          <TextView
              android:layout_width="0dp" android:layout_weight="1"
              android:layout_height="wrap_content"
              android:text="实时归档"
              android:textSize="13sp" android:textColor="@color/sub"/>
          <TextView
              android:id="@+id/stateTag"
              android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="@string/state_off"
              android:textSize="11sp" android:textColor="@color/ok"
              android:background="@drawable/tag_ok"
              android:paddingStart="9dp" android:paddingEnd="9dp"
              android:paddingTop="4dp" android:paddingBottom="4dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/statsBig"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="今日归档 0 条 · 拦截撤回 0"
            android:textSize="19sp" android:textStyle="bold" android:textColor="@color/ink"/>
        <TextView
            android:id="@+id/capLine"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="当前档位：普通 · 最后归档 --"
            android:textSize="12sp" android:textColor="@color/faint"/>
        <TextView
            android:id="@+id/mediaLine"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="媒体 0 · 表情 0"
            android:textSize="12sp" android:textColor="@color/sub"
            android:padding="2dp"/>
      </LinearLayout>

      <!-- 引导卡（未授权时显示） -->
      <LinearLayout
          android:id="@+id/guideCard"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="12dp" android:visibility="gone"
          android:orientation="vertical" android:padding="18dp"
          android:background="@drawable/glass_card_accent">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/guide_title"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/accent"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/guide_desc"
            android:textSize="13sp" android:lineSpacingExtra="3dp"
            android:textColor="@color/sub"/>
        <TextView
            android:id="@+id/btnGoNotify"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/guide_btn"
            android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="9dp" android:paddingBottom="9dp"/>
      </LinearLayout>

      <!-- 搜索框（隐藏，点搜索按钮展开） -->
      <LinearLayout
          android:id="@+id/searchBox"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="14dp" android:visibility="gone"
          android:orientation="horizontal" android:gravity="center_vertical"
          android:padding="10dp" android:background="@drawable/search_box">
        <ImageView
            android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_search" android:contentDescription=""/>
        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="@string/search_hint"
            android:textSize="14sp"
            android:textColor="@color/ink"
            android:textColorHint="@color/faint"
            android:singleLine="true"/>
      </LinearLayout>

      <!-- 搜索结果 -->
      <ListView
          android:id="@+id/searchList"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:visibility="gone"
          android:divider="@null" android:dividerHeight="0dp"
          android:layout_marginTop="12dp"/>

      <!-- 会话列表 -->
      <ListView
          android:id="@+id/convList"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:divider="@null" android:dividerHeight="0dp"/>

      <!-- 空态卡 -->
      <LinearLayout
          android:id="@+id/emptyCard"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="14dp" android:visibility="gone"
          android:orientation="vertical" android:gravity="center_horizontal"
          android:padding="34dp" android:background="@drawable/glass_card">
        <ImageView
            android:layout_width="46dp" android:layout_height="46dp"
            android:src="@drawable/ic_shield" android:contentDescription=""/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/empty_title"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/empty_desc"
            android:textSize="13sp" android:lineSpacingExtra="3dp"
            android:gravity="center"
            android:textColor="@color/sub"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>
</FrameLayout>

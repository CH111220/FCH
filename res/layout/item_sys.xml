<?xml version="1.0" encoding="utf-8"?>
<!-- 组卡内的撤回提示行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="24dp"
    android:paddingTop="4dp" android:paddingBottom="10dp">
  <TextView
      android:id="@+id/sysText"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="对方撤回了一条消息 · 21:03"
      android:textSize="13sp" android:textStyle="italic"
      android:textColor="@color/sub"
      android:paddingStart="12dp" android:paddingEnd="12dp"
      android:paddingTop="8dp" android:paddingBottom="8dp"
      android:background="@drawable/bubble_white"/>
</LinearLayout>
